# Server Configuration
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/sliit_mindease

# MongoDB DNS/SRV reliability options (helpful for Atlas on unstable local DNS)
# Set to false to disable public DNS forcing
MONGO_FORCE_PUBLIC_DNS=true
# Comma-separated DNS resolvers used when MONGO_FORCE_PUBLIC_DNS=true
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional: ipv4first | verbatim
MONGO_DNS_RESULT_ORDER=ipv4first

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secret_key_here
